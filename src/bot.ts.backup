import TelegramBot from "node-telegram-bot-api";


const bot = new TelegramBot(process.env.BOT_TOKEN!);


const webhookUrl = "https://swift-ocean-75b46bbe.tunnl.gg/webhook";
// Register the webhook and wait for Telegram's confirmation
async function init() {
    try {
        const info = await bot.getWebhookInfo();


        if (info.url !== webhookUrl) {
            await bot.setWebhook(webhookUrl);
            console.log("Telegram webhook registered successfully!");
        } else {
            console.log("Telegram webhook already registered!");
        }
    } catch (error) {
        console.error("Webhook registration failed:", error);
    }
}


void init();


// Listen for incoming Telegram messages
bot.on("message", async (msg) => {
    const chatId = msg.chat.id;
    const message = msg.text?.trim().toLowerCase();


    console.log("Incoming Telegram message:", message);


    try {
        switch (message) {
            case "/start":
                await bot.sendMessage(
                    chatId,
                    `Hi ${msg.from?.username || msg.from?.first_name || "there"}!`,
                    {
                        reply_markup: {
                            keyboard: [[{ text: "/help" }]],
                            resize_keyboard: true,
                            one_time_keyboard: true,
                        },
                    }
                );
                break;


            case "/help":
                await bot.sendMessage(
                    chatId,
                    "This is just a test bot."
                );
                break;


            default:
                await bot.sendMessage(
                    chatId,
                    "Hello, I am a bot!"
                );
        }
    } catch (error) {
        console.error("Message handling failed:", error);
    }
});


export default bot;